<?xml version="1.0" encoding="UTF-8"?>
<!--
  Example launchd agent for running /cx-eod automatically on macOS.

  This is a GENERIC TEMPLATE. Before loading it:
    1. Replace __CLAUDE_BIN__ with the absolute path to the `claude` CLI
       (find it with: which claude).
    2. Replace __HOME__ with your home directory (e.g. /Users/you).
    3. Adjust the StartCalendarInterval entries to the hours you want.
       The entries below fire at 15:00, 19:00 and 22:00 every day — change
       or remove them to taste.

  Install with the helper:  bash examples/launchd/install-cx-eod-agent.sh
  Or manually:
    cp this file to ~/Library/LaunchAgents/com.cortex.cx-eod.plist
    launchctl load ~/Library/LaunchAgents/com.cortex.cx-eod.plist

  cx-eod is idempotent: running it three times a day regenerates the same
  day's summary file (it looks back 24h) and records each run under
  "## Ejecuciones hoy" — no duplicated content.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cortex.cx-eod</string>

    <key>ProgramArguments</key>
    <array>
        <string>__CLAUDE_BIN__</string>
        <string>-p</string>
        <string>/cx-eod --auto</string>
    </array>

    <!-- Run at 15:00, 19:00 and 22:00 every day. Edit/remove as needed. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key><integer>15</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>19</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>22</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
    </array>

    <!-- Do not pile up missed runs if the Mac was asleep at the scheduled time. -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__HOME__/.claude/cortex/log/cx-eod-launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.claude/cortex/log/cx-eod-launchd.err.log</string>
</dict>
</plist>
