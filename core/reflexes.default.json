{
  "version": "2.3.0",
  "reflexes": [
    {
      "id": "read-before-edit",
      "matcher": "Edit|Write",
      "action": "Verify the file was Read recently. If not, read it first.",
      "severity": "high",
      "enabled": true,
      "fireCount": 0,
      "usefulCount": 0,
      "noiseCount": 0,
      "lastFired": null,
      "evaluator": {
        "type": "precondition-check",
        "precondition_tool": "Read",
        "match_field": "file_path",
        "lookback": 10
      }
    },
    {
      "id": "env-never-commit",
      "matcher": "Bash",
      "condition": "git add|git commit",
      "action": "Verify .env* files are in .gitignore. NEVER commit secrets.",
      "severity": "critical",
      "enabled": true,
      "fireCount": 0,
      "usefulCount": 0,
      "noiseCount": 0,
      "lastFired": null,
      "evaluator": {
        "type": "error-monitor",
        "error_pattern": "secret|api[_-]?key|token|password|credential|leaked|exposed",
        "window": 10
      }
    },
    {
      "id": "test-after-change",
      "matcher": "Edit|Write",
      "condition": "route\\.ts|component|\\.test\\.",
      "action": "Code modified. Consider running tests.",
      "severity": "medium",
      "enabled": true,
      "fireCount": 0,
      "usefulCount": 0,
      "noiseCount": 0,
      "lastFired": null,
      "evaluator": {
        "type": "error-monitor",
        "error_pattern": "test.*fail|FAIL|expect.*received|assertion",
        "window": 15
      }
    },
    {
      "id": "git-commit-quality",
      "matcher": "Bash",
      "condition": "git commit",
      "action": "Before committing: verify tests pass, lint clean, conventional format.",
      "severity": "high",
      "enabled": true,
      "fireCount": 0,
      "usefulCount": 0,
      "noiseCount": 0,
      "lastFired": null,
      "evaluator": {
        "type": "error-monitor",
        "error_pattern": "pre-commit hook failed|husky|lint-staged|commit aborted",
        "window": 5
      }
    },
    {
      "id": "git-push-safety",
      "matcher": "Bash",
      "condition": "git push|gh pr create",
      "action": "Before pushing: fetch+rebase first. Use --force-with-lease for force pushes.",
      "severity": "high",
      "enabled": true,
      "fireCount": 0,
      "usefulCount": 0,
      "noiseCount": 0,
      "lastFired": null,
      "evaluator": {
        "type": "error-monitor",
        "error_pattern": "rejected|non-fast-forward|push declined|protected branch",
        "window": 5
      }
    },
    {
      "id": "git-merge-verify",
      "matcher": "Bash",
      "condition": "gh pr merge",
      "action": "Verify all checks pass. Clean up branch after merge.",
      "severity": "high",
      "enabled": true,
      "fireCount": 0,
      "usefulCount": 0,
      "noiseCount": 0,
      "lastFired": null,
      "evaluator": {
        "type": "error-monitor",
        "error_pattern": "merge conflict|cannot be merged|checks failing|required status",
        "window": 5
      }
    },
    {
      "id": "api-auth-check",
      "matcher": "Edit|Write",
      "condition": "route\\.ts|api/",
      "action": "API routes must validate authentication before returning data.",
      "severity": "high",
      "enabled": true,
      "fireCount": 0,
      "usefulCount": 0,
      "noiseCount": 0,
      "lastFired": null,
      "evaluator": {
        "type": "error-monitor",
        "error_pattern": "401|403|unauthorized|forbidden|RLS|policy",
        "window": 15
      }
    },
    {
      "id": "security-headers",
      "matcher": "Edit|Write",
      "condition": "vercel\\.json|next\\.config",
      "action": "Verify security headers: X-Frame-Options, CSP, Referrer-Policy.",
      "severity": "high",
      "enabled": true,
      "fireCount": 0,
      "usefulCount": 0,
      "noiseCount": 0,
      "lastFired": null,
      "evaluator": {
        "type": "error-monitor",
        "error_pattern": "CSP violation|X-Frame|clickjacking|missing.*header",
        "window": 15
      }
    },
    {
      "id": "bash-cat-use-read",
      "matcher": "Bash",
      "condition": "^(cat|head|tail)\\s+[\\.\\/~]?\\S*\\.(py|js|jsx|ts|tsx|md|json|ya?ml|sh|html|css|toml|cfg|ini|conf|sql|env)\\b",
      "action": "Use Read tool (with limit/offset) instead of cat/head/tail for source files.",
      "severity": "medium",
      "enabled": true,
      "fireCount": 0,
      "usefulCount": 0,
      "noiseCount": 0,
      "lastFired": null,
      "evaluator": {
        "type": "tool-substitution",
        "expected_tool": "Read",
        "anti_tool": "Bash",
        "anti_pattern": "^(cat|head|tail)\\s+[\\.\\/~]?\\S*\\.(py|js|jsx|ts|tsx|md|json|ya?ml|sh|html|css|toml|cfg|ini|conf|sql|env)\\b",
        "window": 3
      }
    },
    {
      "id": "bash-grep-use-grep-tool",
      "matcher": "Bash",
      "condition": "^grep\\s+(-[a-zA-Z]*[rR])",
      "action": "Use Grep tool instead of recursive grep — structured output, faster, no permission issues.",
      "severity": "medium",
      "enabled": true,
      "fireCount": 0,
      "usefulCount": 0,
      "noiseCount": 0,
      "lastFired": null,
      "evaluator": {
        "type": "tool-substitution",
        "expected_tool": "Grep",
        "anti_tool": "Bash",
        "anti_pattern": "^grep\\s+(-[a-zA-Z]*[rR])",
        "window": 3
      }
    },
    {
      "id": "bash-find-use-glob",
      "matcher": "Bash",
      "condition": "^find\\s+\\S+\\s+-name\\s+\\S+(?!.*-(exec|delete|newer|mtime|print0|prune))",
      "action": "Use Glob tool instead of find for plain -name searches — faster, no permission issues.",
      "severity": "medium",
      "enabled": true,
      "fireCount": 0,
      "usefulCount": 0,
      "noiseCount": 0,
      "lastFired": null,
      "evaluator": {
        "type": "tool-substitution",
        "expected_tool": "Glob",
        "anti_tool": "Bash",
        "anti_pattern": "^find\\s+\\S+\\s+-name\\s+\\S+(?!.*-(exec|delete|newer|mtime|print0|prune))",
        "window": 3
      }
    }
  ]
}
