{
  "version": "2.2.0",
  "reflexes": [
    {
      "id": "read-before-edit",
      "matcher": "Edit|Write",
      "action": "Verify the file was Read recently. If not, read it first.",
      "severity": "high",
      "enabled": true,
      "fireCount": 0,
      "usefulCount": 0,
      "noiseCount": 0,
      "lastFired": null,
      "evaluator": {
        "type": "precondition-check",
        "precondition_tool": "Read",
        "match_field": "file_path",
        "lookback": 10
      }
    },
    {
      "id": "env-never-commit",
      "matcher": "Bash",
      "condition": "git add|git commit",
      "action": "Verify .env* files are in .gitignore. NEVER commit secrets.",
      "severity": "critical",
      "enabled": true,
      "fireCount": 0,
      "usefulCount": 0,
      "noiseCount": 0,
      "lastFired": null,
      "evaluator": {
        "type": "error-monitor",
        "error_pattern": "secret|api[_-]?key|token|password|credential|leaked|exposed",
        "window": 10
      }
    },
    {
      "id": "test-after-change",
      "matcher": "Edit|Write",
      "condition": "route\\.ts|component|\\.test\\.",
      "action": "Code modified. Consider running tests.",
      "severity": "medium",
      "enabled": true,
      "fireCount": 0,
      "usefulCount": 0,
      "noiseCount": 0,
      "lastFired": null,
      "evaluator": {
        "type": "error-monitor",
        "error_pattern": "test.*fail|FAIL|expect.*received|assertion",
        "window": 15
      }
    },
    {
      "id": "git-commit-quality",
      "matcher": "Bash",
      "condition": "git commit",
      "action": "Before committing: verify tests pass, lint clean, conventional format.",
      "severity": "high",
      "enabled": true,
      "fireCount": 0,
      "usefulCount": 0,
      "noiseCount": 0,
      "lastFired": null,
      "evaluator": {
        "type": "error-monitor",
        "error_pattern": "pre-commit hook failed|husky|lint-staged|commit aborted",
        "window": 5
      }
    },
    {
      "id": "git-push-safety",
      "matcher": "Bash",
      "condition": "git push|gh pr create",
      "action": "Before pushing: fetch+rebase first. Use --force-with-lease for force pushes.",
      "severity": "high",
      "enabled": true,
      "fireCount": 0,
      "usefulCount": 0,
      "noiseCount": 0,
      "lastFired": null,
      "evaluator": {
        "type": "error-monitor",
        "error_pattern": "rejected|non-fast-forward|push declined|protected branch",
        "window": 5
      }
    },
    {
      "id": "git-merge-verify",
      "matcher": "Bash",
      "condition": "gh pr merge",
      "action": "Verify all checks pass. Clean up branch after merge.",
      "severity": "high",
      "enabled": true,
      "fireCount": 0,
      "usefulCount": 0,
      "noiseCount": 0,
      "lastFired": null,
      "evaluator": {
        "type": "error-monitor",
        "error_pattern": "merge conflict|cannot be merged|checks failing|required status",
        "window": 5
      }
    },
    {
      "id": "api-auth-check",
      "matcher": "Edit|Write",
      "condition": "route\\.ts|api/",
      "action": "API routes must validate authentication before returning data.",
      "severity": "high",
      "enabled": true,
      "fireCount": 0,
      "usefulCount": 0,
      "noiseCount": 0,
      "lastFired": null,
      "evaluator": {
        "type": "error-monitor",
        "error_pattern": "401|403|unauthorized|forbidden|RLS|policy",
        "window": 15
      }
    },
    {
      "id": "security-headers",
      "matcher": "Edit|Write",
      "condition": "vercel\\.json|next\\.config",
      "action": "Verify security headers: X-Frame-Options, CSP, Referrer-Policy.",
      "severity": "high",
      "enabled": true,
      "fireCount": 0,
      "usefulCount": 0,
      "noiseCount": 0,
      "lastFired": null,
      "evaluator": {
        "type": "error-monitor",
        "error_pattern": "CSP violation|X-Frame|clickjacking|missing.*header",
        "window": 15
      }
    },
    {
      "id": "instinct-downvote",
      "matcher": "Bash",
      "condition": "/cx-downvote|wrong instinct|ignore instinct|bad instinct|instinct incorrecto",
      "action": "Negative feedback detected. Use /cx-downvote to record it and reduce instinct confidence.",
      "severity": "low",
      "enabled": true,
      "fireCount": 0,
      "usefulCount": 0,
      "noiseCount": 0,
      "lastFired": null
    },
    {
      "id": "capture-decision",
      "matcher": "Bash|Edit|Write",
      "condition": "from now on|always use|never use|switching to|no longer use|de ahora en adelante|siempre usar|nunca usar",
      "action": "Strategic decision detected. Consider saving to memory or creating a Cortex instinct with /cx-gotcha.",
      "severity": "low",
      "enabled": true,
      "fireCount": 0,
      "usefulCount": 0,
      "noiseCount": 0,
      "lastFired": null
    }
  ]
}
